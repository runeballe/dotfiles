#!/usr/bin/env python3
"""hypr-screen: use an Android phone as an extra Hyprland monitor, Sidecar-style.

Runs as a background user service (see install.sh):
  * USB: when a phone with the Hypr Screen app is plugged in, writes the pairing
    record into the app's private storage with adb, sets up `adb reverse` and
    opens the app, which connects and becomes a monitor.
  * Wi-Fi (opt-in): answers discovery broadcasts so paired phones can connect.
    A new phone can also pair over Wi-Fi: both screens show the same 6-digit
    code, and the request is accepted on the laptop and on the phone.

Security: every connection is TLS 1.3 with a self-signed certificate that the
phone pins (fingerprint delivered over adb), and the phone must prove it holds
the pairing secret (HMAC over both sides' nonces). The secret never travels
over the socket during USB pairing. Wi-Fi pairing sends a per-phone secret
over TLS only after the user has checked that both screens show the same code;
the code covers the certificate fingerprint and both sides' nonces (with a
commitment), so a man in the middle can't make the codes match.

Each session creates a headless Hyprland output at the phone's resolution,
captures it with wf-recorder (H.264, VAAPI) and streams it to the phone; touch
and key events come back and are replayed through uinput devices.
Settings: ~/.config/hypr-screen/config.json
"""
import argparse
import fcntl
import hashlib
import hmac
import json
import os
import queue
import re
import select
import shutil
import signal
import socket
import ssl
import struct
import subprocess
import sys
import tempfile
import threading
import time

VERSION = "0.5.0"
PORT = 7878
OUTPUT = "HYPRSCREEN"
PACKAGE = "com.hyprscreen"
PAIR_DIR = f"/sdcard/Android/data/{PACKAGE}/files"
PROTO = "3"
FLAG_CONFIG, FLAG_KEY, FLAG_INFO = 1, 2, 4  # INFO: "<w> <h> <codec> <host features>" before each new stream
FLAG_BYE = 8  # the laptop ended the session on purpose: don't reconnect (sent to 0.5.0+ phones)
KICK_SECONDS = 25  # after --disconnect, refuse that phone this long (older phones retry for 20 s)
H_PEN, H_TRACKPAD = 1, 2  # host features in INFO (0.4.0+): phones fall back to plain touch without them
LINGER_SECONDS = 15  # keep a Wi-Fi phone's monitor this long while it reconnects
START = b"\x00\x00\x00\x01"
CONF_DIR = os.path.expanduser("~/.config/hypr-screen")
HANDSHAKE_SECONDS = 6
MAX_PENDING = 8  # unauthenticated connections handled at once
PAIR_SECONDS = 90  # time to accept a Wi-Fi pairing request
PAIR_COOLDOWN = 10  # seconds to ignore new requests after one is rejected
PAIR_CLASS = "hypr-screen-pair"
HEX32 = re.compile(r"[0-9a-f]{32}")
DEVICE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,39}")  # no leading "-": it's passed as argv
DEFAULTS = {
    "scale": 1.5,
    "position": "auto-right",
    "fps": 60,
    "qp": 24,
    "encoder": "vaapi",
    "device": "/dev/dri/renderD128",
    "auto_usb": True,
    "wifi": False,
    "wifi_pairing": True,
    "codec": "auto",  # auto (HEVC when the phone supports it), h264 or hevc
    "adaptive": True,  # on Wi-Fi, lower quality / frame rate while the link can't keep up
    "workspaces": [],  # workspaces to put on the phone's monitor while it is connected, e.g. [8, 9]
    "mirror_output": "",  # mirror mode: monitor to show ("" = the one you are using)
    "phones": {},  # per phone (id from --devices, or "usb"): {"position": ..., "workspaces": [...]}
}


def log(msg):
    print(f"hypr-screen: {msg}", file=sys.stderr, flush=True)


def run(*cmd, check=True, timeout=15):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)} failed: {(r.stderr or r.stdout).strip()}")
    return r.stdout.strip()


def notify(title, body=""):
    try:
        subprocess.run(["notify-send", "-a", "Hypr Screen", "-i", "video-display", title, body],
                       capture_output=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def quietly(fn, *args):
    try:
        fn(*args)
    except Exception as e:  # cleanup steps must never stop the next one
        log(f"cleanup: {getattr(fn, '__name__', fn)}: {e}")


# --------------------------------------------------------------------- config / identity

def load_config():
    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(CONF_DIR, "config.json")
    cfg = dict(DEFAULTS)
    if os.path.exists(path):
        with open(path) as f:
            cfg.update(json.load(f))
    else:
        with open(path, "w") as f:
            json.dump(DEFAULTS, f, indent=2)
    return cfg


def _write_private(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(data)


def load_identity():
    """Host id, pairing secret and TLS certificate (all created on first run)."""
    path = os.path.join(CONF_DIR, "identity.json")
    if os.path.exists(path):
        with open(path) as f:
            ident = json.load(f)
    else:
        ident = {"id": os.urandom(6).hex(), "secret": os.urandom(32).hex()}
        _write_private(path, json.dumps(ident))

    cert = os.path.join(CONF_DIR, "cert.pem")
    key = os.path.join(CONF_DIR, "key.pem")
    if not (os.path.exists(cert) and os.path.exists(key)):
        old = os.umask(0o077)
        try:
            run("openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
                "-nodes", "-keyout", key, "-out", cert, "-days", "3650", "-subj", "/CN=hypr-screen")
        finally:
            os.umask(old)
    with open(cert) as f:
        der = ssl.PEM_cert_to_DER_cert(f.read())
    ident["cert"], ident["key"] = cert, key
    ident["fingerprint"] = hashlib.sha256(der).hexdigest()
    return ident


def tls_context(ident):
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_3
    ctx.load_cert_chain(ident["cert"], ident["key"])
    return ctx


def mac(secret_hex, label, server_nonce, client_nonce):
    msg = f"{label}|{server_nonce}|{client_nonce}".encode()
    return hmac.new(bytes.fromhex(secret_hex), msg, hashlib.sha256).hexdigest()


def pair_code(fingerprint, client_nonce, server_nonce):
    """6-digit code both screens show during Wi-Fi pairing."""
    digest = hashlib.sha256(f"hs-code|{fingerprint}|{client_nonce}|{server_nonce}".encode()).digest()
    return f"{int.from_bytes(digest[:4], 'big') % 1_000_000:06d}"


DEVICES_PATH = os.path.join(CONF_DIR, "devices.json")
devices_lock = threading.Lock()


def load_devices():
    """Phones paired over Wi-Fi: {device id: {"name", "secret", "added"}}."""
    try:
        with open(DEVICES_PATH) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_devices(devices):
    fd, tmp = tempfile.mkstemp(prefix=".devices-", dir=CONF_DIR)  # mode 600
    with os.fdopen(fd, "w") as f:
        json.dump(devices, f, indent=2)
    os.replace(tmp, DEVICES_PATH)


class DevicesLock:
    """Serialises read-modify-write of devices.json across threads and processes (daemon and CLI)."""
    def __enter__(self):
        devices_lock.acquire()
        os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
        self.fd = os.open(os.path.join(CONF_DIR, ".devices.lock"), os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        os.close(self.fd)  # releases the flock
        devices_lock.release()


# --------------------------------------------------------------------- hyprland

def set_monitor(mode, position, scale):
    """Apply a monitor rule; Hyprland's Lua config needs `eval`, older ones `keyword`."""
    lua = f'hl.monitor({{ output = "{OUTPUT}", mode = "{mode}", position = "{position}", scale = {scale} }})'
    out = run("hyprctl", "eval", lua, check=False)
    if out.strip() != "ok":
        run("hyprctl", "keyword", "monitor", f"{OUTPUT},{mode},{position},{scale}")


def create_output():
    run("hyprctl", "output", "remove", OUTPUT, check=False)  # stale from a crash
    out = run("hyprctl", "output", "create", "headless", OUTPUT)
    if out.strip() != "ok":
        raise RuntimeError(f"could not create output: {out}")


def remove_monitor():
    run("hyprctl", "output", "remove", OUTPUT, check=False)


def recorder_cmd(cfg, fifo, codec="h264", fps=None, qp=None, output=OUTPUT):
    g = str(int(fps or cfg["fps"]) * 2)
    qp = int(qp if qp is not None else cfg["qp"])
    cmd = ["wf-recorder", "-y", "-o", output, "-m", "flv", "-f", fifo]
    if cfg["encoder"] == "vaapi":
        cmd += ["-c", "hevc_vaapi" if codec == "hevc" else "h264_vaapi", "-d", cfg["device"],
                "-p", "bf=0", "-p", f"g={g}", "-p", f"qp={qp}"]
    else:
        cmd += ["-c", "libx264", "-x", "yuv420p", "-p", "preset=ultrafast",
                "-p", "tune=zerolatency", "-p", f"crf={qp}", "-p", "bf=0", "-p", f"g={g}"]
    return cmd


# --------------------------------------------------------------------- FLV -> frames

def read_exact(f, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = f.read(n - len(buf))
        if not chunk:
            raise EOFError
        buf += chunk
    return bytes(buf)


def avcc_to_annexb(payload, nal_len_size):
    out, i = bytearray(), 0
    while i + nal_len_size <= len(payload):
        n = int.from_bytes(payload[i:i + nal_len_size], "big")
        i += nal_len_size
        out += START + payload[i:i + n]
        i += n
    return bytes(out)


def parse_avcc_config(body):
    """AVCDecoderConfigurationRecord -> (Annex-B SPS+PPS, NAL length size)."""
    nal_len_size = (body[4] & 3) + 1
    out, p = bytearray(), 6
    for _ in range(body[5] & 0x1F):
        n = int.from_bytes(body[p:p + 2], "big"); p += 2
        out += START + body[p:p + n]; p += n
    npps = body[p]; p += 1
    for _ in range(npps):
        n = int.from_bytes(body[p:p + 2], "big"); p += 2
        out += START + body[p:p + n]; p += n
    return bytes(out), nal_len_size


def parse_hvcc_config(body):
    """HEVCDecoderConfigurationRecord -> (Annex-B VPS+SPS+PPS, NAL length size)."""
    nal_len_size = (body[21] & 3) + 1
    out, p = bytearray(), 23
    for _ in range(body[22]):
        p += 1  # array_completeness | NAL unit type
        count = int.from_bytes(body[p:p + 2], "big"); p += 2
        for _ in range(count):
            n = int.from_bytes(body[p:p + 2], "big"); p += 2
            out += START + body[p:p + n]; p += n
    return bytes(out), nal_len_size


def flv_video_tag(data):
    """Classic AVC or enhanced-FLV HEVC video tag -> (kind, frame_type, body), kind = config/frame/None."""
    if data[0] & 0x80:  # enhanced FLV: frame type, packet type, FourCC
        packet, frame_type, fourcc = data[0] & 0x0F, (data[0] >> 4) & 0x07, data[1:5]
        if fourcc != b"hvc1":
            return None, 0, b""
        if packet == 0:
            return "config", frame_type, data[5:]
        if packet == 1:
            return "frame", frame_type, data[8:]  # skips the 3-byte composition time
        if packet == 3:
            return "frame", frame_type, data[5:]
        return None, 0, b""
    if len(data) < 5 or (data[0] & 0x0F) != 7:
        return None, 0, b""
    kind = {0: "config", 1: "frame"}.get(data[1])
    return kind, data[0] >> 4, data[5:]


def flv_frames(fifo_path, out_q, stop):
    """Thread: wf-recorder FLV -> framed H.264/HEVC access units on out_q (None = end)."""
    try:
        with open(fifo_path, "rb", buffering=0) as f:
            read_exact(f, 9 + 4)  # FLV header + PreviousTagSize0
            nal_len_size = 4
            while not stop.is_set():
                th = read_exact(f, 11)
                size = int.from_bytes(th[1:4], "big")
                ts = int.from_bytes(th[4:7], "big") | (th[7] << 24)
                data = read_exact(f, size)
                read_exact(f, 4)
                if th[0] != 9 or len(data) < 5:
                    continue  # not a video tag
                kind, frame_type, body = flv_video_tag(data)
                if kind == "config":
                    hevc = bool(data[0] & 0x80)
                    payload, nal_len_size = (parse_hvcc_config if hevc else parse_avcc_config)(body)
                    flags = FLAG_CONFIG
                elif kind == "frame":
                    payload = avcc_to_annexb(body, nal_len_size)
                    flags = FLAG_KEY if frame_type == 1 else 0
                else:
                    continue
                frame = struct.pack(">IBI", len(payload), flags, ts & 0xFFFFFFFF) + payload
                while not stop.is_set():  # backpressure: a slow link slows capture, never drops
                    try:
                        out_q.put(frame, timeout=0.2)
                        break
                    except queue.Full:
                        pass
    except (EOFError, OSError, IndexError):
        pass
    finally:
        try:
            out_q.put_nowait(None)
        except queue.Full:
            pass


# --------------------------------------------------------------------- uinput devices

EV_SYN, EV_KEY, EV_REL, EV_ABS = 0, 1, 2, 3
BTN_TOUCH = 0x14A
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
BTN_TOOL_PEN, BTN_TOOL_RUBBER, BTN_STYLUS = 0x140, 0x141, 0x14B
ABS_X, ABS_Y = 0x00, 0x01
ABS_PRESSURE, ABS_TILT_X, ABS_TILT_Y = 0x18, 0x1A, 0x1B
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL, REL_WHEEL_HI_RES, REL_HWHEEL_HI_RES = 0x00, 0x01, 0x06, 0x08, 0x0B, 0x0C
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x2F, 0x35, 0x36, 0x39
INPUT_PROP_DIRECT = 0x01
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556E
UI_SET_RELBIT = 0x40045566
UI_DEV_SETUP, UI_ABS_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x405C5503, 0x401C5504, 0x5501, 0x5502
TOUCH_NAME = "hypr-screen-touch"
KBD_NAME = "hypr-screen-keyboard"
PEN_NAME = "hypr-screen-pen"
MOUSE_NAME = "hypr-screen-mouse"
MAX_SLOTS = 10
T_SYNC, T_DOWN, T_MOVE, T_UP = 0, 1, 2, 3
K_TAP, K_CHAR, K_RAW = 10, 11, 14
# Control messages (phone -> laptop). Laptops before 0.3.0 ignore them.
C_VIEW, C_PREF, C_HELLO, C_BYE = 20, 21, 22, 23  # VIEW: x=w y=h; PREF: slot=key x=value; HELLO: x=features
F_INFO, F_HEVC, F_BYE = 1, 2, 4  # phone features: understands INFO frames; can decode HEVC; BYE frames
P_FPS, P_SCALE, P_CODEC, P_RES, P_MODE = 1, 2, 3, 4, 5  # P_MODE: 0 extend, 1 mirror  # PREF keys: fps; scale*100 (0 = laptop default); 1 = H.264 only; resolution %
# Stylus (0.4.0): AUX carries x=pressure 0..65535, y=(tilt_x+90) | (tilt_y+90) << 8; POS slot = PEN_* flags.
S_AUX, S_POS = 30, 31
PEN_TOUCH, PEN_ERASER, PEN_BUTTON, PEN_RANGE = 1, 2, 4, 8
# Trackpad mode (0.4.0): x/y are signed 16-bit. BTN slot 0/1/2 = left/right/middle, x = pressed.
# SCROLL in 1/120 notches. GESTURE slot 1 = next workspace, 2 = previous.
M_MOVE, M_BTN, M_SCROLL, M_GESTURE = 40, 41, 42, 43


def s16(v):
    return v - 0x10000 if v >= 0x8000 else v
MSG = struct.Struct(">BBHH")  # type, slot/mods, x, y

# Keys a remote device must never press: they act even behind the lock screen.
KEY_SYSRQ, KEY_POWER, KEY_SLEEP, KEY_WAKEUP, KEY_SUSPEND = 99, 116, 142, 143, 205
DENIED_KEYS = {KEY_SYSRQ, KEY_POWER, KEY_SLEEP, KEY_WAKEUP, KEY_SUSPEND}
ALLOWED_KEYS = [k for k in range(1, 248) if k not in DENIED_KEYS]


class UInput:
    """Minimal /dev/uinput device; subclasses describe their capabilities."""

    def __init__(self, name, product, setup):
        import fcntl
        self._ioctl = fcntl.ioctl
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        try:
            setup(lambda req, arg: fcntl.ioctl(self.fd, req, arg))
            fcntl.ioctl(self.fd, UI_DEV_SETUP, struct.pack("<HHHH80sI", 0x06, 0x1209, product, 1, name.encode(), 0))
            fcntl.ioctl(self.fd, UI_DEV_CREATE, 0)
        except Exception:
            os.close(self.fd)
            raise

    def emit(self, t, code, value):
        os.write(self.fd, struct.pack("llHHi", 0, 0, t, code, value))

    def destroy(self):
        try:
            self._ioctl(self.fd, UI_DEV_DESTROY, 0)
        finally:
            os.close(self.fd)


class Touchscreen(UInput):
    """A virtual multitouch screen; Hyprland maps it onto the phone's output."""

    def __init__(self, w, h, dpi):
        dpi = min(max(int(dpi), 50), 1000)
        res_x = max(1, round(65535 / (w / dpi * 25.4)))  # units per mm, for gesture speed
        res_y = max(1, round(65535 / (h / dpi * 25.4)))

        def setup(io):
            for ev in (EV_SYN, EV_KEY, EV_ABS):
                io(UI_SET_EVBIT, ev)
            io(UI_SET_KEYBIT, BTN_TOUCH)
            io(UI_SET_PROPBIT, INPUT_PROP_DIRECT)
            for code, mx, res in ((ABS_X, 65535, res_x), (ABS_Y, 65535, res_y),
                                  (ABS_MT_SLOT, MAX_SLOTS - 1, 0),
                                  (ABS_MT_POSITION_X, 65535, res_x), (ABS_MT_POSITION_Y, 65535, res_y),
                                  (ABS_MT_TRACKING_ID, 65535, 0)):
                io(UI_SET_ABSBIT, code)
                io(UI_ABS_SETUP, struct.pack("<H2xiiiiii", code, 0, 0, mx, 0, 0, res))

        super().__init__(TOUCH_NAME, 0x7878, setup)
        self.size = (w, h)
        self.active = {}  # slot -> tracking id
        self.next_id = 1
        self.primary = None

    def handle(self, kind, slot, x, y):
        if kind == T_SYNC:
            self.emit(EV_SYN, 0, 0)
            return
        if slot >= MAX_SLOTS:
            return
        if kind == T_DOWN:
            if slot in self.active:
                return
            self.emit(EV_ABS, ABS_MT_SLOT, slot)
            self.emit(EV_ABS, ABS_MT_TRACKING_ID, self.next_id)
            self.active[slot] = self.next_id
            self.next_id = (self.next_id % 65535) + 1
            self.emit(EV_ABS, ABS_MT_POSITION_X, x)
            self.emit(EV_ABS, ABS_MT_POSITION_Y, y)
            if self.primary is None:
                self.primary = slot
                self.emit(EV_KEY, BTN_TOUCH, 1)
        elif kind == T_MOVE and slot in self.active:
            self.emit(EV_ABS, ABS_MT_SLOT, slot)
            self.emit(EV_ABS, ABS_MT_POSITION_X, x)
            self.emit(EV_ABS, ABS_MT_POSITION_Y, y)
        elif kind == T_UP and slot in self.active:
            self.emit(EV_ABS, ABS_MT_SLOT, slot)
            self.emit(EV_ABS, ABS_MT_TRACKING_ID, -1)
            del self.active[slot]
            if not self.active:
                self.primary = None
                self.emit(EV_KEY, BTN_TOUCH, 0)
        if slot == self.primary and kind in (T_DOWN, T_MOVE):
            self.emit(EV_ABS, ABS_X, x)
            self.emit(EV_ABS, ABS_Y, y)

    def close(self):
        try:
            for slot in list(self.active):
                self.handle(T_UP, slot, 0, 0)
            self.handle(T_SYNC, 0, 0, 0)
        finally:
            self.destroy()


MOD_CTRL, MOD_ALT, MOD_SHIFT, MOD_SUPER = 1, 2, 4, 8
MOD_KEYS = ((MOD_CTRL, 29), (MOD_ALT, 56), (MOD_SHIFT, 42), (MOD_SUPER, 125))


class Pen(UInput):
    """A virtual drawing tablet (pressure, tilt, eraser, barrel button) mapped onto the phone's output."""

    def __init__(self, output=OUTPUT):
        def setup(io):
            for ev in (EV_SYN, EV_KEY, EV_ABS):
                io(UI_SET_EVBIT, ev)
            for key in (BTN_TOUCH, BTN_TOOL_PEN, BTN_TOOL_RUBBER, BTN_STYLUS):
                io(UI_SET_KEYBIT, key)
            io(UI_SET_PROPBIT, INPUT_PROP_DIRECT)
            for code, lo, hi in ((ABS_X, 0, 65535), (ABS_Y, 0, 65535), (ABS_PRESSURE, 0, 4095),
                                 (ABS_TILT_X, -90, 90), (ABS_TILT_Y, -90, 90)):
                io(UI_SET_ABSBIT, code)
                io(UI_ABS_SETUP, struct.pack("<H2xiiiiii", code, 0, lo, hi, 0, 0, 0))

        # Map before the device appears, like the touchscreen: Hyprland applies it when a device is added.
        map_device(PEN_NAME, output)
        super().__init__(PEN_NAME, 0x7879, setup)
        self.tool = None  # BTN_TOOL_PEN / BTN_TOOL_RUBBER while the pen is in range
        self.touching = self.button = False
        self.pressure, self.tilt = 0, (0, 0)

    def aux(self, pressure, tilts):
        self.pressure = pressure * 4095 // 65535
        self.tilt = (min(max((tilts & 0xFF) - 90, -90), 90), min(max((tilts >> 8) - 90, -90), 90))

    def pos(self, flags, x, y):
        in_range = bool(flags & (PEN_RANGE | PEN_TOUCH))
        tool = (BTN_TOOL_RUBBER if flags & PEN_ERASER else BTN_TOOL_PEN) if in_range else None
        touching, button = bool(flags & PEN_TOUCH) and in_range, bool(flags & PEN_BUTTON) and in_range
        if tool != self.tool and self.tool is not None:  # tool changed or left: lift it first
            if self.touching:
                self.emit(EV_KEY, BTN_TOUCH, 0)
                self.emit(EV_ABS, ABS_PRESSURE, 0)
                self.touching = False
            if self.button:
                self.emit(EV_KEY, BTN_STYLUS, 0)
                self.button = False
            self.emit(EV_KEY, self.tool, 0)
            self.emit(EV_SYN, 0, 0)
            self.tool = None
        if tool is None:
            return
        self.emit(EV_ABS, ABS_X, x)
        self.emit(EV_ABS, ABS_Y, y)
        self.emit(EV_ABS, ABS_TILT_X, self.tilt[0])
        self.emit(EV_ABS, ABS_TILT_Y, self.tilt[1])
        self.emit(EV_ABS, ABS_PRESSURE, self.pressure if touching else 0)
        if self.tool is None:
            self.emit(EV_KEY, tool, 1)
            self.tool = tool
        if touching != self.touching:
            self.emit(EV_KEY, BTN_TOUCH, int(touching))
            self.touching = touching
        if button != self.button:
            self.emit(EV_KEY, BTN_STYLUS, int(button))
            self.button = button
        self.emit(EV_SYN, 0, 0)

    def close(self):
        try:
            self.pos(0, 0, 0)
        finally:
            self.destroy()


class Mouse(UInput):
    """Relative pointer for trackpad mode (moves the cursor on every monitor, like a laptop touchpad)."""
    BUTTONS = (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE)

    def __init__(self):
        def setup(io):
            for ev in (EV_SYN, EV_KEY, EV_REL):
                io(UI_SET_EVBIT, ev)
            for key in self.BUTTONS:
                io(UI_SET_KEYBIT, key)
            for rel in (REL_X, REL_Y, REL_WHEEL, REL_HWHEEL, REL_WHEEL_HI_RES, REL_HWHEEL_HI_RES):
                io(UI_SET_RELBIT, rel)

        super().__init__(MOUSE_NAME, 0x787A, setup)
        self.down = set()
        self.wheel_acc = [0, 0]  # hi-res remainder for the legacy wheel events (vertical, horizontal)

    def move(self, dx, dy):
        if dx:
            self.emit(EV_REL, REL_X, dx)
        if dy:
            self.emit(EV_REL, REL_Y, dy)
        self.emit(EV_SYN, 0, 0)

    def button(self, which, pressed):
        if which >= len(self.BUTTONS):
            return
        code = self.BUTTONS[which]
        if pressed == (code in self.down):
            return
        (self.down.add if pressed else self.down.discard)(code)
        self.emit(EV_KEY, code, int(pressed))
        self.emit(EV_SYN, 0, 0)

    def scroll(self, dx, dy):
        for i, (v, hi, lo) in enumerate(((-dy, REL_WHEEL_HI_RES, REL_WHEEL), (dx, REL_HWHEEL_HI_RES, REL_HWHEEL))):
            if not v:
                continue
            self.emit(EV_REL, hi, v)
            self.wheel_acc[i] += v
            notches = int(self.wheel_acc[i] / 120)
            if notches:
                self.emit(EV_REL, lo, notches)
                self.wheel_acc[i] -= notches * 120
        self.emit(EV_SYN, 0, 0)

    def close(self):
        try:
            for i in range(len(self.BUTTONS)):
                self.button(i, False)
        finally:
            self.destroy()


def _us_keymap():
    """char -> (evdev keycode, needs shift) for the US layout."""
    m = {}
    for row, start in (("qwertyuiop", 16), ("asdfghjkl", 30), ("zxcvbnm", 44)):
        for i, c in enumerate(row):
            m[c] = (start + i, False)
            m[c.upper()] = (start + i, True)
    for i, c in enumerate("1234567890"):
        m[c] = (2 + i, False)
    for i, c in enumerate("!@#$%^&*()"):
        m[c] = (2 + i, True)
    plain = {"-": 12, "=": 13, "[": 26, "]": 27, ";": 39, "'": 40, "`": 41, "\\": 43,
             ",": 51, ".": 52, "/": 53, " ": 57, "\n": 28, "\t": 15}
    shifted = {"_": 12, "+": 13, "{": 26, "}": 27, ":": 39, '"': 40, "~": 41, "|": 43,
               "<": 51, ">": 52, "?": 53}
    m.update({c: (k, False) for c, k in plain.items()})
    m.update({c: (k, True) for c, k in shifted.items()})
    return m


US_KEYMAP = _us_keymap()


class Keyboard(UInput):
    """A virtual keyboard: phone keyboard text, extra keys and Bluetooth keyboards."""

    def __init__(self):
        def setup(io):
            io(UI_SET_EVBIT, EV_SYN)
            io(UI_SET_EVBIT, EV_KEY)
            for code in ALLOWED_KEYS:
                io(UI_SET_KEYBIT, code)

        super().__init__(KBD_NAME, 0x7879, setup)
        self.down = set()

    def _key(self, code, value):
        if code in DENIED_KEYS or not 0 < code < 248:
            return
        self.emit(EV_KEY, code, value)
        self.emit(EV_SYN, 0, 0)
        (self.down.add if value else self.down.discard)(code)

    def tap(self, code, mods=0):
        held = [k for bit, k in MOD_KEYS if mods & bit]
        for k in held:
            self._key(k, 1)
        self._key(code, 1)
        self._key(code, 0)
        for k in reversed(held):
            self._key(k, 0)

    def char(self, cp, mods=0):
        ch = chr(cp)
        if ch in US_KEYMAP:
            code, shift = US_KEYMAP[ch]
            self.tap(code, mods | (MOD_SHIFT if shift else 0))
        elif ch.isprintable() and shutil.which("wtype"):
            try:
                subprocess.run(["wtype", "--", ch], capture_output=True, timeout=2)  # any Unicode
            except subprocess.TimeoutExpired:
                pass

    def handle(self, kind, mods, x, y):
        if kind == K_TAP:
            self.tap(x, mods)
        elif kind == K_CHAR:
            cp = x | (y << 16)
            if 0x20 <= cp < 0x110000 or cp in (0x09, 0x0A):
                self.char(cp, mods)
        elif kind == K_RAW:
            self._key(x, 1 if y else 0)

    def close(self):
        try:
            for code in list(self.down):
                self._key(code, 0)
        finally:
            self.destroy()


def run_lua_or_legacy(lua, *legacy):
    """hyprctl eval <lua> on the Lua config; the legacy hyprctl command otherwise."""
    if run("hyprctl", "eval", lua, check=False).strip() != "ok":
        run("hyprctl", *legacy, check=False)


POSITION_RE = re.compile(r"auto(-[a-z-]{1,20})?|-?[0-9]{1,5}x-?[0-9]{1,5}")


def control_path():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "hypr-screen.sock")


def ask_daemon(*words):
    """Send one command to the running service; its JSON reply, or None if it isn't running."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(3)
    try:
        s.connect(control_path())
        s.sendall(" ".join(words).encode() + b"\n")
        return json.loads(s.makefile().readline())
    except (OSError, ValueError):
        return None
    finally:
        s.close()


def phone_settings(cfg, device):
    """Position and workspaces for this phone: its own entry in "phones", else the global ones."""
    phones = cfg.get("phones")
    own = phones.get(device) if isinstance(phones, dict) else None
    if not isinstance(own, dict):
        own = {}
    pos = str(own.get("position", cfg["position"]))
    if not POSITION_RE.fullmatch(pos):
        log(f"ignoring position {pos!r} (use auto, auto-right, ... or e.g. 1920x0)")
        pos = "auto-right"
    ws = own.get("workspaces", cfg.get("workspaces", []))
    return pos, ws if isinstance(ws, list) else []


def map_device(name, output=OUTPUT):
    run_lua_or_legacy(f'hl.device({{ name = "{name}", output = "{output}" }})',
                      "keyword", f"device[{name}]:output", output)


def map_touch_to_output(output=OUTPUT):
    map_device(TOUCH_NAME, output)


def monitors():
    try:
        return json.loads(run("hyprctl", "monitors", "-j", check=False) or "[]")
    except ValueError:
        return []


def mirror_target(cfg):
    """Monitor to mirror: the configured one, else the focused one (never our own output)."""
    mons = [m for m in monitors() if m.get("name") != OUTPUT]
    want = cfg.get("mirror_output") or ""
    for m in mons:
        if m.get("name") == want or (not want and m.get("focused")):
            return m
    return mons[0] if mons else None


def pin_workspaces(workspaces):
    """Put these workspaces on the phone's monitor (existing ones move now, new ones are created there)."""
    for ws in workspaces:
        ws = str(ws)
        if not re.fullmatch(r"[0-9]{1,3}|name:[A-Za-z0-9_-]{1,32}", ws):
            log(f"ignoring workspace {ws!r} (use a number or name:<name>)")
            continue
        run_lua_or_legacy(f'hl.workspace_rule({{ workspace = "{ws}", monitor = "{OUTPUT}" }})',
                          "keyword", "workspace", f"{ws},monitor:{OUTPUT}")
        out = run("hyprctl", "dispatch", f'hl.dsp.workspace.move({{ workspace = "{ws}", monitor = "{OUTPUT}" }})',
                  check=False)
        if "rror" in out and "not found" not in out:  # Hyprland before the Lua config
            run("hyprctl", "dispatch", "moveworkspacetomonitor", ws, OUTPUT, check=False)


def move_window_to_phone():
    if OUTPUT not in run("hyprctl", "monitors", check=False):
        sys.exit("no phone connected")
    out = run("hyprctl", "dispatch", f'hl.dsp.window.move({{ monitor = "{OUTPUT}" }})', check=False).strip()
    if out != "ok" and "error" in out:  # Hyprland before the Lua config
        out = run("hyprctl", "dispatch", "movewindow", f"mon:{OUTPUT}", check=False).strip()
    if out != "ok":
        sys.exit(out)


def switch_workspace(step):
    """Trackpad 3-finger swipe: next/previous existing workspace."""
    rel = "e+1" if step > 0 else "e-1"
    out = run("hyprctl", "dispatch", f'hl.dsp.focus({{ workspace = "{rel}" }})', check=False)
    if out.strip() != "ok":
        run("hyprctl", "dispatch", "workspace", rel, check=False)


# --------------------------------------------------------------------- daemon

# --------------------------------------------------------------------- session / pipeline

class Session:
    """What the phone asked for: size, frame rate, scale, codec. Changes restart the pipeline."""

    def __init__(self, cfg, w, h):
        self.cfg = cfg
        self.w, self.h = w, h
        self.features = 0
        self.fps = int(cfg["fps"])
        self.scale_pref = 0  # 0 = laptop default
        self.res = 100
        self.h264_only = False
        self.mirror = False
        self.target = OUTPUT  # output being captured (another monitor in mirror mode)
        self.position = cfg["position"]
        self.hevc_failed = False
        self.initial = True  # still reading what the phone sent right after OK
        self.kicked = False  # ended from the laptop (--disconnect / --forget)
        self.dirty_at = None  # monotonic time of the last change not yet applied
        self.last_restart = 0.0
        self.sent = False  # any frame reached the phone (set even if the session then fails)
        # Adaptive quality: 0 = as configured, 1 = lower quality, 2 = lower quality and at most 30 fps.
        self.adaptive = False
        self.level = 0
        self.window_start = time.monotonic()
        self.busy = 0.0  # seconds spent in sendall during the current window
        self.calm = 0  # consecutive quiet windows
        self.calm_needed = 4  # quiet windows before stepping up; doubles when a step up fails
        self.last_adapt = 0.0
        self.last_up = -1e9

    def read_initial(self, sock, wait=0.3):
        """Collect the control messages a 0.3.0+ phone sends right after OK. Returns leftover bytes."""
        end = time.monotonic() + wait
        buf = b""
        while time.monotonic() < end:
            sock.settimeout(max(0.01, end - time.monotonic()))
            try:
                chunk = sock.recv(4096)
            except (TimeoutError, socket.timeout, ssl.SSLWantReadError):
                break
            if not chunk:
                break
            buf += chunk
            n = len(buf) // MSG.size * MSG.size
            got_view = False
            for off in range(0, n, MSG.size):
                msg = MSG.unpack_from(buf, off)
                if msg[0] in (C_VIEW, C_PREF, C_HELLO):
                    self.control(*msg)
                    got_view |= msg[0] == C_VIEW
                else:
                    n = off  # input already: leave it for the main loop
                    break
            buf = buf[n:]
            if got_view or n == 0 and buf:
                break
        self.dirty_at = None
        self.initial = False
        return buf

    def control(self, kind, slot, x, y):
        before = self.key()
        if kind == C_HELLO:
            self.features = x
        elif kind == C_VIEW and self.mirror:
            pass  # mirror mode: the size is the mirrored monitor's
        elif kind == C_VIEW and 160 <= x <= 4096 and 160 <= y <= 4096:  # 4096: VAAPI encoder limit
            self.w, self.h = x, y
        elif kind == C_PREF:
            if slot == P_FPS and (x == 0 or 10 <= x <= 120):
                self.fps = x or int(self.cfg["fps"])  # 0 = laptop default
            elif slot == P_SCALE and (x == 0 or 50 <= x <= 400):
                self.scale_pref = x
            elif slot == P_CODEC:
                self.h264_only = x == 1
            elif slot == P_RES and 25 <= x <= 100:
                self.res = x
            elif slot == P_MODE and self.initial:
                self.mirror = x == 1  # chosen when connecting; not switched mid-session
        if self.key() != before:
            self.dirty_at = time.monotonic()

    def restart_due(self):
        """Apply changes once they settle (a rotation can send several sizes in a row)."""
        now = time.monotonic()
        if self.dirty_at is not None and now - self.dirty_at > 0.25 and now - self.last_restart > 1.5:
            self.dirty_at = None
            self.last_restart = now  # at most one restart per 1.5 s, whatever the phone sends
            return True
        return False

    def key(self):
        return (self.w, self.h, self.fps, self.scale(), self.codec())

    def eff_fps(self):
        return min(self.fps, 30) if self.level >= 2 else self.fps

    def qp(self):
        return min(int(self.cfg["qp"]) + (0, 6, 12)[self.level], 51)

    def reset_window(self, delay=0.0):
        """Start a new measuring window (after `delay` s, e.g. to skip a new stream's first keyframe)."""
        self.window_start, self.busy = time.monotonic() + delay, 0.0

    def count_busy(self, t0, t1):
        if t0 >= self.window_start:
            self.busy += t1 - t0

    def adapt_due(self):
        """Every 3 s: if sending blocked most of the time the link is saturated, step down at once.
        Step back up only after a run of quiet windows (and 10 s after any change); if the link
        saturates again soon after stepping up, wait twice as long next time."""
        now = time.monotonic()
        span = now - self.window_start
        if not self.adaptive or span < 3:
            return False
        ratio = self.busy / span
        self.reset_window()
        self.calm = self.calm + 1 if ratio < 0.2 else 0
        if ratio > 0.6 and self.level < 2:
            if now - self.last_up < 30:
                self.calm_needed = min(self.calm_needed * 2, 40)  # it didn't hold: back off
            self.level += 1
        elif self.calm >= self.calm_needed and self.level > 0 and now - self.last_adapt > 10:
            self.level -= 1
            self.last_up = now
        else:
            return False
        self.calm = 0
        self.last_adapt = self.last_restart = now  # shares the restart rate limit with settings changes
        return True

    def scale(self):
        base = self.scale_pref / 100 if self.scale_pref else float(self.cfg["scale"])
        return round(min(max(base * self.res / 100, 0.5), 4.0), 2)  # lower resolution, same layout

    def codec(self):
        want = self.cfg.get("codec", "auto")
        ok = (self.features & F_HEVC and self.cfg["encoder"] == "vaapi"
              and not self.h264_only and not self.hevc_failed)
        return "hevc" if ok and want in ("auto", "hevc") else "h264"

    def describe(self):
        extra = f" (link busy: quality level {self.level})" if self.level else ""
        if self.mirror:
            extra = f" mirroring {self.target}" + extra
        return f"{self.w}x{self.h}@{self.eff_fps()} scale {self.scale()} {self.codec()}{extra}"


class Pipeline:
    """Monitor mode + wf-recorder + FLV reader for the session's current settings."""

    def __init__(self, cfg, sess):
        self.cfg, self.sess = cfg, sess
        self.rec = self.tmp = self.fifo = None
        self.stop_event = threading.Event()
        self.frames = queue.Queue()
        self.started = 0.0

    def start(self, sock):
        s = self.sess
        if not s.mirror:
            set_monitor(f"{s.w}x{s.h}@{s.eff_fps()}", s.position, s.scale())
        self.tmp = tempfile.mkdtemp(prefix="hypr-screen-")
        self.fifo = os.path.join(self.tmp, "stream.flv")
        os.mkfifo(self.fifo, 0o600)
        self.stop_event = threading.Event()
        self.frames = queue.Queue(maxsize=8)
        self.codec = s.codec()
        if s.features & F_INFO:  # tell the phone what is coming before the first config frame
            info = f"{s.w} {s.h} {self.codec} {H_PEN | H_TRACKPAD}".encode()
            sock.settimeout(10)
            sock.sendall(struct.pack(">IBI", len(info), FLAG_INFO, 0) + info)
        with open(os.path.join(self.tmp, "wf-recorder.log"), "w") as errlog:
            self.rec = subprocess.Popen(recorder_cmd(self.cfg, self.fifo, self.codec, s.eff_fps(), s.qp(), s.target),
                                        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=errlog)
        self.started = time.monotonic()
        s.reset_window(delay=1.0)  # the new stream starts with a keyframe burst: don't count it
        threading.Thread(target=flv_frames, args=(self.fifo, self.frames, self.stop_event), daemon=True).start()

    def alive(self):
        return self.rec is not None and self.rec.poll() is None

    def fallback(self):
        """HEVC encoder died right away: remember that and say whether to retry with H.264."""
        if self.codec == "hevc" and time.monotonic() - self.started < 5:
            log("HEVC encoding failed: " + self.error_tail() + "; falling back to H.264")
            self.stop()
            self.sess.hevc_failed = True
            return True
        if self.rec is not None and self.rec.poll() is not None:
            log("wf-recorder exited: " + self.error_tail())
        return False

    def error_tail(self):
        try:
            with open(os.path.join(self.tmp, "wf-recorder.log")) as f:
                return " | ".join(f.read().strip().splitlines()[-3:])
        except (OSError, TypeError):
            return "?"

    def stop(self):
        self.stop_event.set()
        if self.rec and self.rec.poll() is None:
            self.rec.terminate()
            try:
                self.rec.wait(2)
            except subprocess.TimeoutExpired:
                self.rec.kill()
        if self.fifo:
            try:  # unblock the reader if it is still waiting to open the fifo
                os.close(os.open(self.fifo, os.O_WRONLY | os.O_NONBLOCK))
            except OSError:
                pass
        if self.tmp:
            shutil.rmtree(self.tmp, ignore_errors=True)
        self.rec = self.tmp = self.fifo = None


# --------------------------------------------------------------------- pairing prompt

TERMINALS = (  # (binary, args before the command)
    ("xdg-terminal-exec", [f"--app-id={PAIR_CLASS}", "--title=Hypr Screen pairing", "--"]),
    ("kitty", ["--class", PAIR_CLASS, "--title", "Hypr Screen pairing"]),
    ("foot", ["--app-id", PAIR_CLASS, "--title", "Hypr Screen pairing"]),
    ("alacritty", ["--class", PAIR_CLASS, "--title", "Hypr Screen pairing", "-e"]),
    ("ghostty", [f"--class={PAIR_CLASS}", "--title=Hypr Screen pairing", "-e"]),
)


def launch_prompt(result_path, name, addr, code):
    """Open a small floating terminal asking the user to accept the phone. False if none could start."""
    run("hyprctl", "eval", f'hl.window_rule({{ match = {{ class = "{PAIR_CLASS}" }}, float = true, '
        f'center = true, pin = true, size = {{ 620, 330 }} }})', check=False)
    cmd = [sys.executable, os.path.abspath(__file__), "--confirm-pair", result_path, name, addr, code]
    for exe, flags in TERMINALS:
        if shutil.which(exe):
            try:
                subprocess.Popen([exe, *flags, *cmd], start_new_session=True, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except OSError as e:
                log(f"could not start {exe}: {e}")
    return False


def write_result(path, value):
    """First answer wins (the prompt or the daemon cancelling). The file appears complete or not at all."""
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
    except OSError:
        return  # the daemon already cleaned up
    try:
        with os.fdopen(fd, "w") as f:
            f.write(value)
        os.link(tmp, path)  # fails if an answer is already there
    except OSError:
        pass
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def confirm_pair(result_path, name, addr, code):
    """Runs inside the terminal window. The user must type the code shown on the phone and press
    Enter, so a keystroke meant for another window can never accept a request."""
    import termios
    import tty
    b, d, r = "\033[1m", "\033[2m", "\033[0m"
    print(f"\n  {b}Hypr Screen: pairing request{r}\n")
    print(f"  Phone   {b}{name}{r}  {d}({addr}){r}\n")
    print("  If this is your phone, type the 6-digit code it shows")
    print(f"  and press Enter. {d}Esc rejects. It can then use this laptop{r}")
    print(f"  {d}as a display and send keys.{r}\n")
    print("  Code: ", end="", flush=True)
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    typed, answer = "", None
    try:
        tty.setcbreak(fd)
        time.sleep(0.8)
        termios.tcflush(fd, termios.TCIFLUSH)  # drop anything typed before the window appeared
        end = time.monotonic() + PAIR_SECONDS
        while answer is None and time.monotonic() < end and not os.path.exists(result_path):
            if not select.select([fd], [], [], 0.3)[0]:
                continue
            ch = os.read(fd, 1).decode(errors="ignore")
            if ch == "\x1b":
                answer = "no"
            elif ch.isdigit() and len(typed) < 6:
                typed += ch
                print(ch + (" " if len(typed) == 3 else ""), end="", flush=True)
            elif ch in ("\x7f", "\b") and typed:
                typed = typed[:-1]
                print("\r  Code: " + " " * 8 + "\r  Code: " + typed[:3] + (" " + typed[3:] if len(typed) > 3 else ""),
                      end="", flush=True)
            elif ch in ("\n", "\r") and len(typed) == 6:
                answer = "yes" if hmac.compare_digest(typed, code) else "wrong"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    if answer is None:
        print("\n\n  Request ended." if os.path.exists(result_path) else "\n\n  Timed out.")
    else:
        write_result(result_path, "yes" if answer == "yes" else "no")
        print("\n\n  " + {"yes": "Accepted. Tap Confirm on the phone if you haven't yet.",
                           "wrong": "Wrong code. Request rejected.", "no": "Rejected."}[answer])
    time.sleep(1.5)


class Daemon:
    def __init__(self, cfg, ident):
        self.cfg = cfg
        self.ident = ident
        self.ctx = tls_context(ident)
        self.busy = threading.Lock()
        self.pending = threading.BoundedSemaphore(MAX_PENDING)
        self.pair_lock = threading.Lock()  # one pairing request at a time
        self.linger_lock = threading.Lock()
        self.linger_token = None  # set while a disconnected Wi-Fi phone's monitor is kept
        self.pair_quiet_until = 0.0
        self.active = None  # the connected phone: device, name, via, since, conn, session
        self.last_device = None  # device of the most recent session (for a kick while its monitor lingers)
        self.kicked_until = {}  # device -> monotonic time until which it may not reconnect
        self.pen_output = OUTPUT
        self.hostname = socket.gethostname().replace(" ", "-")[:64] or "laptop"

    # ---- local control socket: --status, --disconnect, --forget
    def control_server(self):
        path = control_path()
        if ask_daemon("status") is not None:
            log("another hypr-screen is running; --status/--disconnect talk to that one")
            return
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(path)
        os.chmod(path, 0o600)
        srv.listen(8)
        while True:
            try:
                c, _ = srv.accept()
            except OSError:
                time.sleep(0.5)
                continue
            threading.Thread(target=self.control_client, args=(c,), daemon=True).start()

    def control_client(self, c):
        with c:
            c.settimeout(2)
            try:
                req = c.recv(256).decode().split()
            except (OSError, UnicodeDecodeError):
                return
            cmd = req[0] if req else ""
            if cmd == "status":
                reply = self.status()
            elif cmd == "disconnect":
                reply = {"ended": self.kick()}
            elif cmd == "forget" and len(req) == 2:
                reply = {"ended": self.kick(req[1])}
            else:
                reply = {"error": "unknown command"}
            try:
                c.sendall(json.dumps(reply).encode() + b"\n")
            except OSError:
                pass

    def kick(self, device=None):
        """End the current session (only if it is `device`'s). The monitor goes away at once."""
        a = self.active
        if not a:  # a Wi-Fi phone may be reconnecting to its lingering monitor: stop that too
            dev = self.last_device
            if dev is None or device is not None and dev != device:
                return False
            with self.linger_lock:
                if self.linger_token is None:
                    return False
                self.linger_token = None
            self.kicked_until[dev] = time.monotonic() + KICK_SECONDS
            quietly(remove_monitor)
            return True
        if device is not None and a["device"] != device:
            return False
        a["session"].kicked = True  # the stream thread says goodbye and ends
        self.kicked_until[a["device"]] = time.monotonic() + KICK_SECONDS
        def force():  # if the stream thread is stuck in a send
            if self.active is a:
                try:  # socket-level shutdown on the fd; doesn't touch the OpenSSL object
                    socket.socket.shutdown(a["conn"], socket.SHUT_RDWR)
                except OSError:
                    pass
        t = threading.Timer(3, force)
        t.daemon = True
        t.start()
        return True

    def status(self):
        """Waybar / Omarchy bar module JSON."""
        a = self.active
        if not a:
            return {"text": "", "tooltip": "Hypr Screen: no phone connected", "class": "idle", "alt": "idle"}
        s = a["session"]
        mins = int(time.time() - a["since"]) // 60
        what = f"mirroring {s.target}" if s.mirror else f"{s.w}×{s.h} @ {s.eff_fps()} fps"
        tip = f"{a['name']} via {a['via']}\n{what}, connected {mins} min"
        if s.level:
            tip += f"\nlink busy: quality level {s.level}"
        cls = "mirror" if s.mirror else "connected"
        return {"text": "\U000f011c", "tooltip": tip, "class": cls, "alt": cls}

    # ---- TCP: TLS + challenge, then one display session at a time
    def serve(self):
        bind = "0.0.0.0" if self.cfg["wifi"] else "127.0.0.1"
        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        srv.bind((bind, PORT))
        srv.listen(16)
        log(f"listening on {bind}:{PORT} (host {self.hostname}, id {self.ident['id']})")
        while True:
            try:
                conn, addr = srv.accept()
            except OSError as e:  # e.g. EMFILE under load: back off, keep serving
                log(f"accept: {e}")
                time.sleep(0.5)
                continue
            if not self.pending.acquire(blocking=False):
                conn.close()  # too many unauthenticated connections
                continue
            try:
                threading.Thread(target=self.session, args=(conn, addr), daemon=True).start()
            except RuntimeError:
                self.pending.release()
                conn.close()

    def session(self, conn, addr):
        authed = False
        tls = None
        try:
            tls, w, h, dpi, device = self.handshake(conn, addr)
            if tls is None:
                return
            self.pending.release()
            authed = True
            if time.monotonic() < self.kicked_until.get(device, 0):
                tls.sendall(b"BUSY\n")  # just disconnected from the laptop: don't come straight back
                return
            if not self.busy.acquire(blocking=False):
                tls.sendall(b"BUSY\n")
                return
            try:
                tls.sendall(b"OK\n")
                self.stream(tls, w, h, dpi, "USB" if addr[0] == "127.0.0.1" else addr[0], device)
            finally:
                self.busy.release()
        except Exception as e:  # keep the daemon alive whatever a client does
            log(f"session from {addr[0]} ended: {e}")
        finally:
            if not authed:
                self.pending.release()
            for s in (tls, conn):
                if s is not None:
                    try:
                        s.close()
                    except OSError:
                        pass

    @staticmethod
    def readline(tls, deadline):
        """One protocol line (max 512 bytes) before the deadline, or None."""
        line = b""
        while not line.endswith(b"\n"):
            left = deadline - time.monotonic()
            if left <= 0 or len(line) > 512:
                return None
            tls.settimeout(left)
            chunk = tls.recv(1)  # byte at a time: never read past the line
            if not chunk:
                return None
            line += chunk
        return line.decode(errors="replace").split()

    def handshake(self, conn, addr):
        """TLS, then: HELLO -> HYPRSCREEN <w> <h> <dpi> <client nonce> <proof> [device].
        Returns (tls, w, h, dpi, device); tls is None when the connection ends here.
        device is the Wi-Fi pairing id, or "usb" for phones paired over USB."""
        deadline = time.monotonic() + HANDSHAKE_SECONDS
        conn.settimeout(HANDSHAKE_SECONDS)
        tls = self.ctx.wrap_socket(conn, server_side=True)
        nonce = os.urandom(16).hex()
        tls.sendall(f"HELLO {PROTO} {self.ident['id']} {self.hostname} {nonce}\n".encode())
        parts = self.readline(tls, deadline)
        if not parts or parts[:1] == ["PING"]:  # PING: availability probe from the app
            return None, 0, 0, 0, None
        if parts[:2] == ["PAIR", PROTO]:
            self.pair(tls, parts, addr)
            return None, 0, 0, 0, None
        if len(parts) not in (7, 8) or parts[:2] != ["HYPRSCREEN", PROTO]:
            return None, 0, 0, 0, None
        try:
            w, h, dpi = int(parts[2]), int(parts[3]), int(parts[4])
        except ValueError:
            return None, 0, 0, 0, None
        client_nonce, proof = parts[5], parts[6]
        if len(parts) == 8:  # paired over Wi-Fi: per-phone secret
            with DevicesLock():
                secret = load_devices().get(parts[7], {}).get("secret")
        else:  # paired over USB
            secret = self.ident["secret"]
        if not secret or not HEX32.fullmatch(client_nonce) or not hmac.compare_digest(
                proof, mac(secret, "c", nonce, client_nonce)):
            tls.sendall(b"DENIED\n")
            log(f"rejected a device without a valid pairing ({addr[0]})")
            return None, 0, 0, 0, None
        if not (100 <= w <= 8192 and 100 <= h <= 8192):
            return None, 0, 0, 0, None
        return tls, w, h, dpi, parts[7] if len(parts) == 8 else "usb"

    # ---- Wi-Fi pairing
    def pair(self, tls, parts, addr):
        """PAIR <proto> <commit> <name> -> PAIRNONCE <ns> -> PAIRREVEAL <nc>, then both users confirm
        the code and the phone gets PAIRED <device id> <secret> (or DENIED)."""
        if len(parts) != 4 or not re.fullmatch(r"[0-9a-f]{64}", parts[2]) or not DEVICE_NAME.fullmatch(parts[3]):
            return
        if not (self.cfg["wifi_pairing"] and self.cfg["wifi"]):
            tls.sendall(b"DENIED\n")
            return
        if time.monotonic() < self.pair_quiet_until or not self.pair_lock.acquire(blocking=False):
            tls.sendall(b"BUSY\n")
            return
        try:
            self._pair(tls, parts[2], parts[3], addr[0])
        finally:
            self.pair_lock.release()

    def _pair(self, tls, commit, name, addr):
        server_nonce = os.urandom(16).hex()
        tls.sendall(f"PAIRNONCE {server_nonce}\n".encode())
        reveal = self.readline(tls, time.monotonic() + HANDSHAKE_SECONDS)
        if not reveal or len(reveal) != 2 or reveal[0] != "PAIRREVEAL" or not HEX32.fullmatch(reveal[1]):
            return
        client_nonce = reveal[1]
        # The phone committed to its nonce before seeing ours, so nobody can steer the code.
        if not hmac.compare_digest(hashlib.sha256(f"hs-commit|{client_nonce}".encode()).hexdigest(), commit):
            return
        code = pair_code(self.ident["fingerprint"], client_nonce, server_nonce)
        log(f"pairing request from {name} ({addr})")
        tmp = tempfile.mkdtemp(prefix="hypr-screen-pair-", dir=os.environ.get("XDG_RUNTIME_DIR"))
        result = os.path.join(tmp, "result")
        outcome = "failed"
        try:
            if not launch_prompt(result, name, addr, code):
                log("no terminal found to ask about the pairing request; install kitty, foot or alacritty")
                tls.sendall(b"DENIED\n")
                return
            outcome = self._await_pair(tls, result)
        finally:
            if outcome != "paired":  # also on errors: no new prompt for a while
                self.pair_quiet_until = time.monotonic() + PAIR_COOLDOWN
            write_result(result, "cancelled")  # closes the prompt if it is still open
            time.sleep(0.5)
            shutil.rmtree(tmp, ignore_errors=True)
        if outcome == "paired":
            device, secret = os.urandom(6).hex(), os.urandom(32).hex()
            with DevicesLock():
                devices = load_devices()
                devices[device] = {"name": name, "secret": secret, "added": int(time.time())}
                save_devices(devices)
            tls.sendall(f"PAIRED {device} {secret}\n".encode())
            log(f"paired {name} over Wi-Fi (device {device})")
            return
        log(f"pairing with {name} {outcome}")
        if outcome == "rejected":
            quietly(tls.sendall, b"DENIED\n")

    def _await_pair(self, tls, result):
        """Wait until both the laptop prompt and the phone accept. Returns paired/rejected/cancelled/timed out."""
        end = time.monotonic() + PAIR_SECONDS
        phone_ok = False
        buf = b""
        while time.monotonic() < end:
            if os.path.exists(result):
                with open(result) as f:
                    answer = f.read().strip()
                if answer != "yes":
                    return "rejected"
                if phone_ok:
                    return "paired"
            tls.settimeout(0.3)
            try:
                chunk = tls.recv(64)
            except (TimeoutError, socket.timeout):
                continue
            except (OSError, ssl.SSLError):
                return "cancelled"
            if not chunk:
                return "cancelled"
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if line.strip() == b"PAIRCONFIRM":
                    phone_ok = True
                else:  # PAIRCANCEL or anything unexpected
                    return "cancelled"
            if len(buf) > 64:
                return "cancelled"
        return "timed out"

    def stream(self, sock, w, h, dpi, via, device="usb"):
        # The TLS socket is used from this thread only (OpenSSL objects aren't thread-safe).
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        for opt, val in (("TCP_KEEPIDLE", 3), ("TCP_KEEPINTVL", 2), ("TCP_KEEPCNT", 3), ("TCP_USER_TIMEOUT", 6000)):
            if hasattr(socket, opt):
                sock.setsockopt(socket.IPPROTO_TCP, getattr(socket, opt), val)

        sess = Session(self.cfg, w, h)
        sess.adaptive = via != "USB" and bool(self.cfg.get("adaptive", True))
        sess.position, workspaces = phone_settings(self.cfg, device)
        if device == "usb":
            name = "USB phone"
        else:
            with DevicesLock():
                name = load_devices().get(device, {}).get("name", device)
        self.last_device = device
        self.active = {"device": device, "name": name, "via": via, "since": time.time(),
                       "conn": sock, "session": sess}
        pipe = keyboard = None
        self.touch = self.pen = self.mouse = None
        self.last_gesture = 0.0
        bye = False
        have_monitor = False
        try:
            buf = sess.read_initial(sock)  # 0.3.0+ phones announce features/size/prefs first
            if sess.mirror:
                mon = mirror_target(self.cfg)
                if not mon:
                    raise RuntimeError("no monitor to mirror")
                sess.target = mon["name"]
                mw, mh = int(mon["width"]), int(mon["height"])
                if int(mon.get("transform", 0)) % 2:
                    mw, mh = mh, mw
                if mw > 4096 or mh > 4096:
                    raise RuntimeError(f"{sess.target} is too large to mirror ({mw}×{mh})")
                sess.w, sess.h = mw, mh
                if self.reclaim_monitor():
                    quietly(remove_monitor)  # a lingering extended display isn't wanted now
            elif self.reclaim_monitor():
                log("phone is back: reusing its monitor")
                have_monitor = True
            else:
                create_output()
                have_monitor = True
            log(f"display session via {via} ({name}): {sess.describe()}")
            notify("Phone connected as a display", f"{sess.w}×{sess.h} via {via}")
            self.pen_output = sess.target
            try:
                map_touch_to_output(sess.target)
                self.touch = Touchscreen(sess.w, sess.h, dpi)
                keyboard = Keyboard()
            except OSError as e:
                log(f"touch/keyboard input unavailable: {e}")
            pipe = Pipeline(self.cfg, sess)
            pipe.start(sock)
            if workspaces and not sess.mirror:
                threading.Thread(target=pin_workspaces, args=(workspaces,), daemon=True).start()
            self.dpi = dpi
            bye = self.loop(sock, sess, pipe, keyboard, buf)
        finally:
            self.active = None
            if pipe:
                pipe.stop()
            for dev in ("touch", "pen", "mouse"):
                if getattr(self, dev):
                    quietly(getattr(self, dev).close)
                    setattr(self, dev, None)
            if keyboard:
                quietly(keyboard.close)
            # Linger only for a working Wi-Fi session that dropped (not Back, not our own failure).
            linger = have_monitor and sess.sent and via != "USB" and not bye and not sess.kicked
            if linger:
                self.linger_monitor()  # give the phone a moment to come back
            elif have_monitor:
                quietly(remove_monitor)
            log("display session ended" + (f" (monitor kept {LINGER_SECONDS}s)" if linger else ""))
            notify("Phone display disconnected")

    # ---- keep the monitor while a Wi-Fi phone reconnects
    def linger_monitor(self):
        with self.linger_lock:
            token = object()
            self.linger_token = token
        def expire():
            with self.linger_lock:
                if self.linger_token is not token:
                    return  # reclaimed by a new session
                self.linger_token = None
                quietly(remove_monitor)
        t = threading.Timer(LINGER_SECONDS, expire)
        t.daemon = True
        t.start()

    def reclaim_monitor(self):
        """True if a lingering monitor was taken over (windows stay where they were)."""
        with self.linger_lock:
            if self.linger_token is None:
                return False
            self.linger_token = None
            return OUTPUT in run("hyprctl", "monitors", check=False)

    def loop(self, sock, sess, pipe, keyboard, buf=b""):
        """Single-threaded pump: send frames, apply input. Returns True if the session ended on purpose."""
        while True:
            if sess.kicked:
                if sess.features & F_BYE:
                    sock.settimeout(2)
                    sock.sendall(struct.pack(">IBI", 0, FLAG_BYE, 0))
                return True
            try:
                frame = pipe.frames.get(timeout=0.004)
            except queue.Empty:
                frame = b""
            if frame is None or not pipe.alive():
                if pipe.fallback():  # HEVC failed to start: retry with H.264
                    pipe.start(sock)
                    continue
                return False
            if frame:
                sock.settimeout(10)
                t0 = time.monotonic()
                sock.sendall(frame)
                sess.count_busy(t0, time.monotonic())
                sess.sent = True
            sock.settimeout(0)
            while True:  # drain everything the phone has sent
                try:
                    chunk = sock.recv(16384)
                except (ssl.SSLWantReadError, BlockingIOError, socket.timeout):
                    break
                if not chunk:
                    return False  # phone disconnected
                buf += chunk
                if len(buf) > 1 << 20:
                    raise RuntimeError("input flood")
            n = len(buf) // MSG.size * MSG.size
            for off in range(0, n, MSG.size):
                msg = MSG.unpack_from(buf, off)
                kind = msg[0]
                if kind == C_BYE:
                    return True
                if M_MOVE <= kind <= M_GESTURE:
                    self.mouse_msg(*msg)
                elif S_AUX <= kind <= S_POS:
                    self.pen_msg(*msg)
                elif C_VIEW <= kind <= C_BYE:
                    sess.control(*msg)
                elif kind >= 30:
                    pass  # from a newer phone: ignore
                elif kind >= K_TAP:
                    if keyboard:
                        keyboard.handle(*msg)
                elif self.touch:
                    self.touch.handle(*msg)
            buf = buf[n:]
            if sess.adapt_due():
                log(f"adapting to the link: {sess.describe()}")
                pipe.stop()
                pipe.start(sock)
            elif sess.restart_due():
                log(f"reconfiguring: {sess.describe()}")
                pipe.stop()
                if self.touch and (self.touch.size != (sess.w, sess.h)):
                    quietly(self.touch.close)  # new size: rebuild so gesture speed stays right
                    try:
                        self.touch = Touchscreen(sess.w, sess.h, self.dpi)
                    except OSError as e:
                        self.touch = None
                        log(f"touch input unavailable: {e}")
                pipe.start(sock)

    def pen_msg(self, kind, flags, x, y):
        if self.pen is None:
            try:
                self.pen = Pen(self.pen_output)  # created on first use, so phones without a stylus add no device
            except OSError as e:
                log(f"pen input unavailable: {e}")
                self.pen = False
        if not self.pen:
            return
        if kind == S_AUX:
            self.pen.aux(x, y)
        else:
            self.pen.pos(flags, x, y)

    def mouse_msg(self, kind, slot, x, y):
        if kind == M_GESTURE:
            now = time.monotonic()
            if slot in (1, 2) and now - self.last_gesture > 0.3:
                self.last_gesture = now
                threading.Thread(target=switch_workspace, args=(1 if slot == 1 else -1,), daemon=True).start()
            return
        if self.mouse is None:
            try:
                self.mouse = Mouse()
            except OSError as e:
                log(f"trackpad input unavailable: {e}")
                self.mouse = False
        if not self.mouse:
            return
        if kind == M_MOVE:
            self.mouse.move(s16(x), s16(y))
        elif kind == M_BTN:
            self.mouse.button(slot, bool(x))
        elif kind == M_SCROLL:
            self.mouse.scroll(s16(x), s16(y))

    # ---- UDP discovery for Wi-Fi
    def discovery(self):
        u = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        u.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        u.bind(("0.0.0.0", PORT))
        reply = f"HYPRSCREEN-HERE {PROTO} {self.ident['id']} {self.hostname}".encode()
        while True:
            try:
                data, addr = u.recvfrom(256)
                if data.startswith(b"HYPRSCREEN-DISCOVER"):
                    u.sendto(reply, addr)
            except OSError as e:
                log(f"discovery: {e}")
                time.sleep(1)

    # ---- USB: pair over adb, then launch the app
    def pair_over_adb(self, serial):
        """Write the pairing record into the app's private storage (other apps can't read it)."""
        record = json.dumps({"id": self.ident["id"], "name": self.hostname,
                             "secret": self.ident["secret"], "fingerprint": self.ident["fingerprint"]})
        fd, path = tempfile.mkstemp(prefix="hypr-screen-pair-", dir=os.environ.get("XDG_RUNTIME_DIR"))
        try:
            with os.fdopen(fd, "w") as f:
                f.write(record)
            run("adb", "-s", serial, "shell", "mkdir", "-p", PAIR_DIR, check=False)
            run("adb", "-s", serial, "push", path, f"{PAIR_DIR}/pair-{self.ident['id']}.json")
        finally:
            os.unlink(path)

    def usb_watch(self):
        known = set()
        while True:
            try:
                out = run("adb", "devices", check=False, timeout=10)
                serials = {l.split()[0] for l in out.splitlines()[1:] if l.strip().endswith("\tdevice")}
                for s in serials - known:
                    if not run("adb", "-s", s, "shell", "pm", "path", PACKAGE, check=False, timeout=10):
                        continue  # app not installed on this device
                    try:
                        self.pair_over_adb(s)
                    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
                        log(f"pairing {s} failed: {e}")
                        continue
                    run("adb", "-s", s, "reverse", f"tcp:{PORT}", f"tcp:{PORT}", check=False)
                    log(f"USB phone {s} paired and ready")
                    if self.cfg["auto_usb"] and not self.busy.locked():
                        run("adb", "-s", s, "shell", "am", "start", "-n", f"{PACKAGE}/.MainActivity",
                            "--ez", "autoconnect_usb", "true", check=False)
                known = serials
            except (subprocess.TimeoutExpired, OSError) as e:
                log(f"adb: {e}")
            time.sleep(2)


UNIT_PATH = os.path.expanduser("~/.config/systemd/user/hypr-screen.service")
UNIT = """[Unit]
Description=Hypr Screen - use an Android phone as a Hyprland monitor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart={exe}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
"""


def service_exe():
    """Path the service should run. For mise, prefer the shim so upgrades keep working."""
    exe = os.path.realpath(os.path.abspath(sys.argv[0]))
    if "/mise/installs/" in exe:
        shim = os.path.join(os.environ.get("MISE_DATA_DIR", os.path.expanduser("~/.local/share/mise")),
                            "shims", "hypr-screen")
        if os.path.exists(shim):
            return shim
    return exe


def install_service():
    missing = [t for t in ("hyprctl", "wf-recorder", "adb", "openssl") if not shutil.which(t)]
    if missing:
        pkgs = " ".join("android-tools" if t == "adb" else t for t in missing)
        sys.exit(f"missing: {', '.join(missing)}  (Arch: sudo pacman -S {pkgs})")
    exe = service_exe()
    if any(c.isspace() or c in "%\\\"'" for c in exe):
        sys.exit(f"can't use a path with spaces or quotes in a systemd unit: {exe}")
    os.makedirs(os.path.dirname(UNIT_PATH), exist_ok=True)
    with open(UNIT_PATH, "w") as f:
        f.write(UNIT.format(exe=exe))
    for cmd in (["daemon-reload"], ["enable", "hypr-screen.service"], ["restart", "hypr-screen.service"]):
        subprocess.run(["systemctl", "--user", *cmd], check=True)
    print(f"hypr-screen service installed and running ({exe}).\n")
    print("USB: plug in your phone (USB debugging on) with the Hypr Screen app installed.")
    print('Wi-Fi: set "wifi": true in ~/.config/hypr-screen/config.json, run')
    print("  systemctl --user restart hypr-screen")
    print("and, with ufw, allow your LAN only, e.g.: sudo ufw allow from 192.168.1.0/24 to any port 7878")
    print("Then tap Pair in the phone app and type the code it shows into the window on the laptop.")


def uninstall_service():
    subprocess.run(["systemctl", "--user", "disable", "--now", "hypr-screen.service"], check=False)
    if os.path.exists(UNIT_PATH):
        os.unlink(UNIT_PATH)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    print("hypr-screen service removed. Pairing keys stay in ~/.config/hypr-screen (delete it to revoke them).")


def main():
    ap = argparse.ArgumentParser(description="Use an Android phone as a Hyprland monitor (background service).")
    ap.add_argument("--no-usb", action="store_true", help="don't watch for USB phones")
    ap.add_argument("--install-service", action="store_true",
                    help="install and start the systemd user service (starts with your Hyprland session)")
    ap.add_argument("--uninstall-service", action="store_true", help="stop and remove the systemd user service")
    ap.add_argument("--version", action="version", version=f"hypr-screen {VERSION}")
    ap.add_argument("--devices", action="store_true", help="list phones paired over Wi-Fi")
    ap.add_argument("--forget", metavar="DEVICE",
                    help="remove a phone paired over Wi-Fi (id from --devices); ends its session if connected")
    ap.add_argument("--status", action="store_true", help="print the connection state as Waybar/Omarchy bar JSON")
    ap.add_argument("--disconnect", action="store_true", help="end the current phone session")
    ap.add_argument("--move-window", action="store_true", help="move the focused window to the phone's monitor")
    ap.add_argument("--confirm-pair", nargs=4, metavar=("RESULT", "NAME", "ADDR", "CODE"), help=argparse.SUPPRESS)
    args = ap.parse_args()
    if args.install_service:
        install_service()
        return
    if args.uninstall_service:
        uninstall_service()
        return
    if args.confirm_pair:
        confirm_pair(*args.confirm_pair)
        return
    if args.devices:
        devices = load_devices()
        for dev, info in devices.items():
            added = time.strftime("%Y-%m-%d", time.localtime(info.get("added", 0)))
            print(f"{dev}  {info.get('name', '?'):<24} paired {added}")
        if not devices:
            print("No phones paired over Wi-Fi. (USB pairing is reset by deleting ~/.config/hypr-screen/identity.json.)")
        return
    if args.forget:
        with DevicesLock():
            devices = load_devices()
            if devices.pop(args.forget, None) is None:
                sys.exit(f"no paired phone with id {args.forget} (see --devices)")
            save_devices(devices)
        ended = (ask_daemon("forget", args.forget) or {}).get("ended")
        print(f"Forgot {args.forget}. It can no longer connect." + (" Its session was ended." if ended else ""))
        return
    if args.status:
        print(json.dumps(ask_daemon("status") or {"text": "", "tooltip": "Hypr Screen is not running",
                                                  "class": "stopped", "alt": "stopped"}, ensure_ascii=False))
        return
    if args.disconnect:
        r = ask_daemon("disconnect")
        if r is None:
            sys.exit("hypr-screen service is not running")
        print("Disconnected." if r.get("ended") else "No phone connected.")
        return
    if args.move_window:
        move_window_to_phone()
        return
    for tool in ("hyprctl", "wf-recorder", "openssl"):
        if not shutil.which(tool):
            sys.exit(f"{tool} not found (sudo pacman -S {tool})")

    cfg = load_config()
    d = Daemon(cfg, load_identity())
    remove_monitor()  # leftover from a crash
    signal.signal(signal.SIGTERM, lambda *_: (remove_monitor(), os._exit(0)))
    threading.Thread(target=d.control_server, daemon=True).start()
    if cfg["wifi"]:
        threading.Thread(target=d.discovery, daemon=True).start()
    if shutil.which("adb") and not args.no_usb:
        threading.Thread(target=d.usb_watch, daemon=True).start()
    try:
        d.serve()
    except KeyboardInterrupt:
        remove_monitor()


if __name__ == "__main__":
    main()
