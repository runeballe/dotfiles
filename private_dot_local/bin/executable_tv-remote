#!/usr/bin/env python3
"""Send remote-control keys to a Samsung Tizen TV (2016+, e.g. UE65KU6075).

    tv-remote KEY_HDMI1            send one key
    tv-remote KEY_SOURCE KEY_ENTER send several, with a short pause between
    tv-remote xbox | pc            switch to a source named in the config

Uses the TV's local websocket API: ws://<tv>:8001/api/v2/channels/samsung.remote.control
The first connection makes the TV ask "Allow?" on screen; accept it once.
Config: ~/.config/tv-remote.conf (KEY=value lines): TV=, XBOX=, PC=, DELAY=
Pure standard library, no pip packages.
"""
import base64
import json
import os
import socket
import struct
import sys
import time

CONF = os.path.expanduser("~/.config/tv-remote.conf")
cfg = {"TV": "192.168.1.25", "XBOX": "KEY_HDMI1", "PC": "KEY_HDMI2", "DELAY": "0.4"}
if os.path.exists(CONF):
    for line in open(CONF, encoding="utf-8"):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            cfg[k.strip().upper()] = v.strip()

NAME = base64.b64encode(b"Omarchy").decode()


def recv_exact(sock, n):
    data = b""
    while len(data) < n:
        chunk = sock.recv(n - len(data))
        if not chunk:
            raise ConnectionError("TV closed the connection")
        data += chunk
    return data


def recv_frame(sock):
    b1, b2 = recv_exact(sock, 2)
    length = b2 & 0x7F
    if length == 126:
        length = struct.unpack(">H", recv_exact(sock, 2))[0]
    elif length == 127:
        length = struct.unpack(">Q", recv_exact(sock, 8))[0]
    if b2 & 0x80:
        mask = recv_exact(sock, 4)
        data = bytes(c ^ mask[i % 4] for i, c in enumerate(recv_exact(sock, length)))
    else:
        data = recv_exact(sock, length)
    return b1 & 0x0F, data


def send_text(sock, text):
    payload = text.encode()
    header = bytes([0x81])
    n = len(payload)
    if n < 126:
        header += bytes([0x80 | n])
    elif n < 65536:
        header += bytes([0x80 | 126]) + struct.pack(">H", n)
    else:
        header += bytes([0x80 | 127]) + struct.pack(">Q", n)
    mask = os.urandom(4)
    sock.sendall(header + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(payload)))


def connect(host):
    sock = socket.create_connection((host, 8001), timeout=5)
    key = base64.b64encode(os.urandom(16)).decode()
    path = f"/api/v2/channels/samsung.remote.control?name={NAME}"
    sock.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}:8001\r\nUpgrade: websocket\r\n"
                  f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
    response = b""
    while b"\r\n\r\n" not in response:
        chunk = sock.recv(1024)
        if not chunk:
            raise ConnectionError("no handshake reply")
        response += chunk
    if b" 101 " not in response.split(b"\r\n", 1)[0]:
        raise ConnectionError(response.split(b"\r\n", 1)[0].decode(errors="replace"))
    # Wait for ms.channel.connect (the TV sends it once access is allowed).
    sock.settimeout(30)
    while True:
        op, data = recv_frame(sock)
        if op == 1:
            event = json.loads(data).get("event", "")
            if event == "ms.channel.connect":
                return sock
            if event == "ms.channel.unauthorized":
                raise PermissionError("TV refused access (choose Allow on the TV, or check Settings > General > External Device Manager)")


def send_key(sock, key):
    send_text(sock, json.dumps({"method": "ms.remote.control", "params": {
        "Cmd": "Click", "DataOfCmd": key, "Option": "false", "TypeOfRemote": "SendRemoteKey"}}))


def main(argv):
    if not argv:
        print(__doc__.strip())
        return 2
    keys = []
    for arg in argv:
        named = cfg.get(arg.upper())
        keys.extend((named if named and arg.upper() not in ("TV", "DELAY") else arg).split())
    try:
        sock = connect(cfg["TV"])
    except (OSError, ConnectionError, PermissionError) as error:
        print(f"tv-remote: {error}", file=sys.stderr)
        return 1
    with sock:
        for i, key in enumerate(keys):
            if i:
                time.sleep(float(cfg["DELAY"]))
            send_key(sock, key)
        time.sleep(0.3)
    return 0


sys.exit(main(sys.argv[1:]))
