neofetch

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load.
ZSH_THEME="powerlevel10k/powerlevel10k"

# Font mode for powerlevel10k
POWERLEVEL10k_MODE="nerdfont-complete"

# Plugins to load
plugins=(git colorize bundler dotenv rake rbenv ruby golang history-substring-search rust virtualenv zsh-syntax-highlighting zsh-autosuggestions  vscode ssh-agent)

source $ZSH/oh-my-zsh.sh

# User configuration

# Aliases for a few useful commands
alias cleanjunk='find . -type f \( -name ".qicon" -o -name ".apdisk" -o -name ".DS_Store" \) -delete'
alias cpu='(which htop > /dev/null && htop --sort-key PERCENT_CPU) || top -o cpu'
alias ram='(which htop > /dev/null && htop --sort-key RES) || top -o rsize'
alias config1="sudo nano ~/.zshrc"
alias p10k1="sudo nano ~/.p10k.zsh"
alias reload1="source ~/.zshrc"
alias ls='lsd --color=auto'
alias l='lsd -lh'
alias la='lsd -lah'
alias ll='lsd -lAh'
alias grep='grep --color=auto'
alias remove="paru -Rnd"
alias update="omarchy update"
alias inst="paru -Syu --noconfirm"

# Hide the user and computer name in our prompt
DEFAULT_USER=$USER

# History settings
HISTFILE=$HOME/.zsh_history
HISTSIZE=5000
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups

# # NodeJS/nvm config
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Python setup
eval "$(uv generate-shell-completion zsh)"

# Go binaries to the PATH (local setup, don't use homebrew) 
export GOPATH="$HOME/.local/share/go"
export PATH="$PATH:$GOPATH/bin:/usr/local/go/bin"

# 256 color mode
export TERM="xterm-256color"

# Load completions
autoload -U compinit && compinit

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# mise (Node m.m.)
eval "$(mise activate zsh)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
